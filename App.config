<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- a tray program: no background garbage-collection thread, and the workstation collector -->
    <gcConcurrent enabled="false" />
    <gcServer enabled="false" />
  </runtime>
</configuration>
